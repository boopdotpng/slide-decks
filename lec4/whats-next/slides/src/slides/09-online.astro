---
// how blackhole keeps going without in-person meetings. the hardware box is an open question on purpose
const parts = [
  { t: 'a home', s: 'blackhole-py on github for the code, the channel for everything else', cls: '' },
  { t: 'a rhythm', s: 'no meetings. every two weeks, a short demo of what you did, even if it’s broken', cls: '' },
  { t: 'owners', s: 'whoever ships a piece owns it: reviews, questions, what comes next', cls: '' },
  { t: 'the card', s: 'who keeps it, and how do people without one run kernels? we don’t know yet', cls: 'q' },
];
---
<header>
  <div class="section">what’s next</div>
  <h2>blackhole goes online</h2>
  <p class="sub">less like a class, more like people building a project together</p>
</header>
<div class="grid">
  {parts.map((p, i) => <div class={`b ${p.cls} ${i ? 'step' : ''}`}><b>{p.t}</b><span>{p.s}</span>{p.cls === 'q' && <em>open question</em>}</div>)}
</div>
<style>
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; width: 1300px; margin: 0 auto; }
  .b { background: var(--panel); border: 2px solid var(--border); border-left: 6px solid var(--good); border-radius: 12px; padding: 16px 24px; }
  .b b { display: block; font-size: 36px; }
  .b span { display: block; font-size: 25px; line-height: 1.3; color: var(--muted); margin-top: 4px; }
  .b.q { border-left-color: var(--hot); border-style: dashed; border-left-style: solid; }
  .b em { display: inline-block; margin-top: 10px; font-style: normal; font-size: 15px; font-weight: 750; text-transform: uppercase; letter-spacing: .08em;
    color: var(--hot); border: 2px solid var(--hot); border-radius: 7px; padding: 2px 9px; }
</style>
