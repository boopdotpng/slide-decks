---
// the ask: the work picks who carries blackhole forward. qr points at blackhole-py master (src/qr-repo.ts, python qrcode)
import { QR_PATH, QR_SIZE } from '../qr-repo';
import f from '../facts.json';
const steps = [
  ['this week', 'pick a track. say which in the channel'],
  ['in two weeks', 'show something. broken is fine'],
  ['after that', 'if you shipped it, you own it'],
];
---
<header>
  <div class="section">who’s in</div>
  <h2>the work picks who carries it</h2>
</header>
<div class="ask">
  <div class="items">
    {steps.map(([w, s], i) => <div class={`item ${i ? 'step' : ''}`}><i>{i + 1}</i><div><b>{w}</b><span>{s}</span></div></div>)}
  </div>
  <div class="qr">
    <svg viewBox={`-4 -4 ${QR_SIZE + 8} ${QR_SIZE + 8}`} width="300" height="300" shape-rendering="crispEdges">
      <rect class="qr-bg" x="-4" y="-4" width={QR_SIZE + 8} height={QR_SIZE + 8} />
      <path class="qr-dots" d={QR_PATH} />
    </svg>
    <p>start here<br /><code>{f.repo}</code></p>
  </div>
</div>
<style>
  .ask { display: flex; gap: 80px; align-items: center; justify-content: center; }
  .items { width: 820px; display: flex; flex-direction: column; gap: 18px; }
  .item { display: flex; gap: 22px; align-items: center; background: var(--panel); border-left: 6px solid var(--good); border-radius: 10px; padding: 14px 24px; }
  .item i { font-style: normal; font-size: 48px; font-weight: 800; color: var(--good); width: 36px; flex: none; text-align: center; }
  .item b { display: block; font-size: 36px; }
  .item span { display: block; font-size: 26px; line-height: 1.3; color: var(--muted); margin-top: 2px; }
  .qr { text-align: center; width: 420px; }
  .qr svg { border-radius: 10px; }
  /* scanners want dark dots on a light square, in either theme */
  .qr-bg { fill: var(--fg); }
  .qr-dots { fill: var(--bg); }
  :global(:root[data-theme=light]) .qr-bg { fill: var(--bg); }
  :global(:root[data-theme=light]) .qr-dots { fill: var(--fg); }
  .qr p { font-size: 22px; color: var(--muted); margin-top: 12px; }
  .qr code { font-size: 17px; white-space: nowrap; }
</style>
