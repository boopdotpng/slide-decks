---
// open discussion: prompts to fall back on if the room goes quiet. no steps, leave it up
const qs = [
  'what would you build, if you had a card for a month?',
  'what’s blocking you from starting this week?',
  'who has the card after this, and how do the rest of us run kernels?',
  'what did we explain badly this semester?',
  'how did you actually use ai this semester, honestly?',
];
---
<header>
  <div class="section">open discussion</div>
  <h2>your turn</h2>
</header>
<ul class="qs">
  {qs.map((q) => <li>{q}</li>)}
</ul>
<style>
  .qs { width: 1240px; margin: 0 auto; list-style: none; padding: 0; }
  .qs li { font-size: 36px; line-height: 1.3; margin: 0 0 18px; padding-left: 26px; border-left: 5px solid var(--accent); }
</style>
