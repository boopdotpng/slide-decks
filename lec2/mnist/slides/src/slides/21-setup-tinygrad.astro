---
import Code from 'slides/Code';
const cmds = `mkdir mnist
cd mnist
uv venv --python 3.14
git clone https://github.com/tinygrad/tinygrad.git
uv pip install -e ./tinygrad -C editable_mode=compat
source .venv/bin/activate`;
const check = `ls -a
python -c "from tinygrad import Tensor; print((Tensor([1, 2, 3]) * 2).tolist())"`;
const WHAT = [
  ['mkdir, cd', 'a folder for this lab. run everything from in here'],
  ['venv', 'a python 3.14 just for this folder, in .venv (uv downloads it)'],
  ['clone', "tinygrad's code, in tinygrad, next to .venv"],
  ['pip install -e', 'install tinygrad from that folder. -e: edits to its code take effect. compat: so mnist.py, next to the folder, finds it'],
  ['activate', "python now means .venv's python. the prompt shows (mnist)"],
];
---
<header>
  <div class="section">your machine · 2 of 3</div>
  <h2>get tinygrad</h2>
</header>
<div class="s12">
  <Code lang="sh" code={cmds} copy />
  <ol class="what">{WHAT.map(([k, v]) => <li><b>{k}</b><span>{v}</span></li>)}</ol>
</div>
<div class="s12b">
  <h3>check it works</h3>
  <Code lang="sh" code={check} copy />
  <p><code>ls -a</code> shows <code class="ok">.venv</code> and <code class="ok">tinygrad</code> side by side; python prints <code class="ok">[2, 4, 6]</code>. new terminal later? <code>cd mnist</code>, then <code>source .venv/bin/activate</code> again</p>
</div>
<style>
  .s12 { display: grid; grid-template-columns: auto 1fr; gap: 40px; font-size: .6em; width: 100%; align-items: center; }
  .s12 :global(pre.code) { font-size: 1em; line-height: 1.45; }
  .what { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: .3em; color: var(--muted); font-size: .85em; }
  .what li { display: flex; flex-direction: column; }
  .what b { color: var(--fg); font-family: var(--mono); font-weight: 600; }
  .s12b { font-size: .58em; width: 100%; margin-top: .5em; }
  .s12b h3 { color: var(--accent); margin: 0 0 .3em; font-size: 1em; }
  .s12b :global(pre.code) { font-size: .95em; }
  .s12b p { margin: .4em 0 0; color: var(--muted); }
  .s12b .ok { color: var(--good); }
</style>
