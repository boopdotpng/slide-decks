---
// part 2 opener: everything so far was x86-64 + linux; these are the risc-v (rv64 linux) names
const rows = [
  ['your program / kernel', 'ring 3 / ring 0', 'u-mode / s-mode', '(+ m-mode: firmware)'],
  ['ask the kernel', 'syscall', 'ecall', ''],
  ['syscall number', 'rax', 'a7', ''],
  ['arguments', 'rdi, rsi, rdx, …', 'a0, a1, a2, …', ''],
  ['result', 'rax', 'a0', ''],
  ['write / exit', '1 / 60', '64 / 93', 'syscall numbers differ too'],
  ['back to ring 3 / u-mode', 'sysret, iretq', 'sret', ''],
  ['page table register', 'cr3', 'satp', ''],
  ['instructions', '1 to 15 bytes', 'always 4 bytes', ''],
];
---
<header>
  <h2>now open the bytes: risc-v</h2>
  <p class="sub">the host is x86 + linux, but the cores on the card run risc-v. same ideas, new names</p>
</header>
<table class="map">
  <tr><th></th><th>so far (x86-64)</th><th>risc-v</th><th></th></tr>
  {rows.map(([what, x86, rv, note]) => (
    <tr><td>{what}</td><td>{x86}</td><td>{rv}</td><td class="muted">{note}</td></tr>
  ))}
</table>
<style>
  .map { font-size: .72em; margin-top: .4em; }
  .map th { font-size: .75em; color: var(--muted); font-weight: normal; text-align: left; padding: 0 1.6em .3em 0; }
  .map td { padding: .22em 1.6em .22em 0; white-space: nowrap; }
  .map td:first-child { color: var(--muted); }
  .map td:nth-child(2), .map td:nth-child(3) { font-family: var(--mono); }
  .map td:last-child { font-size: .8em; }
  .map tr + tr td { border-top: 1px solid var(--border); }
</style>
