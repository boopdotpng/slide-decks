---
import '../components/lab.css';
import '../components/roles.css';
// configs/task0.json … task4.json as they are in the lab repo (rvfvn/transformer-training-lab, main)
const DIFF = [
  ['task0.json', '9', '0', '1', 'false', '[]'],
  ['task1.json', '9', '1', '1', 'false', '[]'],
  ['task2.json', '9', '2', '1', 'true', '[]'],
  ['task3.json', '10', '2', '1', 'true', '[1]'],
  ['task4.json', '10', '2', '2', 'true', '[1]'],
];
// task3.json's contents (arrays written on one line), with the fields this slide talks about wrapped in spans (raw html: the braces aren't expressions)
const JSON_HTML = `{
  "task": 3,
  <span class="sd">"seed": 0,</span>
  <span class="md">"model": {</span>
    "vocab_size": 36,
    "seq_len": 10,
    <span class="md">"emb_dim": 32,</span>
    <span class="md">"n_layers": 2,</span>
    <span class="md">"n_heads": 1,</span>
    <span class="md">"head_dim": 32,</span>
    <span class="md">"position_embeddings": true,</span>
    <span class="md">"mlp_layers": [1],</span>       <span class="c">← zero-based: after layer 2</span>
    "mlp_size": 64
  },
  <span class="tr">"training": {</span>
    "optimizer": "adam",
    <span class="tr">"learning_rate": 0.001,</span>
    <span class="tr">"batch_size": 64,</span>
    <span class="tr">"steps": 1000,</span>
    "train_examples": 10000,
    "test_examples": 1000
  }
}`;
---
<header>
  <div class="section">lab setup · 4 of 4</div>
  <h2>configuration</h2>
  <p class="sub">one JSON file per experiment: <code>configs/task0.json</code> … <code>configs/task4.json</code></p>
</header>
<div class="c13">
  <div class="card json">
    <div class="kick">configs/task3.json</div>
<pre class="sh" set:html={JSON_HTML} />
  </div>
  <div class="col">
    <div class="card legend">
      <div><span class="sw md"></span><b>model</b>: the network's shape: layers, heads, widths, positions, mlp</div>
      <div><span class="sw tr"></span><b>training</b>: how it learns: learning rate, batch size, steps</div>
      <div><span class="sw sd"></span><b>seed</b>: which random start. task 4 showed it can matter</div>
    </div>
    <div class="card step diff">
      <div class="dh"><span>file</span><span>seq_len</span><span>n_layers</span><span>n_heads</span><span>positions</span><span>mlp_layers</span></div>
      {DIFF.map((r) => <div class="dr">{r.map((c, i) => <span class={i ? 'v' : 'f'}>{c}</span>)}</div>)}
      <p class="muted small">everything else starts the same in all five</p>
    </div>
    <div class="card bar-a step">
      <h3>validate after every edit</h3>
<pre class="sh"><span class="c"># mac</span>
.venv/bin/python check_configs.py
<span class="c"># windows</span>
.\.venv\Scripts\python.exe check_configs.py</pre>
      <p class="small">expected: five <code>[PASS]</code> lines, then <span class="okt">CONFIGS OK</span>. <b>change one setting at a time</b> and write down what it did</p>
    </div>
  </div>
</div>
<div class="src">sources: <a href="https://github.com/rvfvn/transformer-training-lab/tree/main/configs">[14]</a> <a href="https://github.com/rvfvn/transformer-training-lab/blob/main/README.md">[13]</a></div>
<style>
  .c13 { display: grid; grid-template-columns: .9fr 1.25fr; gap: .8em; font-size: .7em; width: 100%; align-items: start; }
  .c13 .col { display: flex; flex-direction: column; gap: .5em; }
  .c13 .json pre.sh { font-size: .7em; line-height: 1.3; }
  .c13 :global(.md) { color: var(--accent); font-weight: 600; } .c13 :global(.tr) { color: var(--update); font-weight: 600; } .c13 :global(.sd) { color: var(--hot); font-weight: 600; }
  .c13 .legend { display: flex; flex-direction: column; gap: .15em; font-size: .85em; }
  .c13 .legend b { color: var(--fg); }
  .c13 .sw { display: inline-block; width: .8em; height: .8em; border-radius: 3px; margin-right: .45em; vertical-align: -.05em; }
  .c13 .sw.md { background: var(--accent); } .c13 .sw.tr { background: var(--update); } .c13 .sw.sd { background: var(--hot); }
  .c13 .dh, .c13 .dr { display: grid; grid-template-columns: 1.5fr .9fr 1fr 1fr 1fr 1.1fr; gap: .3em; font-size: .82em; }
  .c13 .dh { font-size: .7em; color: var(--muted); border-bottom: 1px solid var(--border); padding-bottom: .2em; }
  .c13 .dr { padding: .12em 0; }
  .c13 .dr .f { font-family: var(--mono); } .c13 .dr .v { font-family: var(--mono); color: var(--accent); }
  .c13 h3 { color: var(--accent); }
  .c13 pre.sh { font-size: .8em; }
  .c13 .small b { color: var(--fg); }
  .c13 .okt { font-family: var(--mono); color: var(--good); font-weight: 700; }
</style>
