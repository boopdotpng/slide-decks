---
import Stack, { type Layer } from '../components/Stack.tsx';
const layers: Layer[] = [
  { t: 'your model', sub: 'python', tone: 'code' },
  { t: 'tt-forge · tt-nn', sub: 'frameworks and operations' },
  { t: 'tt-metalium', sub: 'the official way to program the chip' },
  { t: 'low-level kernel library', sub: 'tt-llk' },
  { t: 'drivers', sub: 'tt-umd, tt-kmd: a linux kernel module' },
  { t: 'the card', tone: 'hw' },
];
---
<header>
  <div class="section">the software catch</div>
  <h2>great hardware, hard to program</h2>
  <p class="sub">tenstorrent’s official software stack</p>
</header>
<div class="catch">
  <div><Stack client:load layers={layers} width={540} compact /></div>
  <div class="pts">
    <div class="pt"><b>linux only</b><span>the official driver runs inside linux. no mac, no windows</span></div>
    <div class="pt"><b>1 math operation = 3 programs</b><span>written by hand, which turn into 5 separate programs on the chip</span></div>
    <div class="pt"><b>everything in 32 × 32 blocks</b><span>data that doesn’t fit the block shape gets padded first</span></div>
  </div>
</div>
<style>
  .catch { display: flex; gap: 80px; align-items: center; justify-content: center; }
  .pts { width: 720px; display: flex; flex-direction: column; gap: 18px; }
  .pt { background: var(--panel); border-left: 6px solid var(--hot); border-radius: 10px; padding: 12px 22px; }
  .pt b { display: block; font-size: 32px; }
  .pt span { display: block; font-size: 23px; line-height: 1.3; color: var(--muted); }
</style>
