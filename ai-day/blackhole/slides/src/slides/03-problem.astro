---
// the problem and the answer on one slide: what you can read, layer by layer, on nvidia vs amd vs the tenstorrent card.
// steps: nvidia alone, then amd (to its left), then tenstorrent with the card's specs. open / closed per layer, nov 2026:
//   nvidia: pytorch open; nvcc / ptxas, cublas / cudnn, cuda runtime + libcuda closed; linux kernel modules open since
//   2022; gpu firmware is signed blobs; sass encodings undocumented.
//   amd: rocm is open source (llvm amdgpu backend, rocblas / miopen, hip + rocr runtime, amdgpu / amdkfd in linux);
//   firmware (psp, smu, mec, ...) is signed blobs; isa guides published. tinygrad runs amd gpus with none of rocm: its
//   own code generator (tinygrad/renderer/amd) and its own python driver (tinygrad/runtime/support/am), loading only
//   amd's firmware blobs.
//   tenstorrent: everything open except the rtl (tt-system-firmware has a few small third-party blobs); isa documented
//   in tenstorrent/tt-isa-documentation.
import f from '../facts.json';
type Side = { t: string; open: boolean | 'mostly' };
type Col = 'amd' | 'nv' | 'tt';
const cols: { k: Col; name: string; foot: string }[] = [
  { k: 'amd', name: 'an amd gpu', foot: 'tinygrad runs it with no rocm: its own compiler + python driver' },
  { k: 'nv', name: 'an nvidia gpu', foot: 'pytorch is open. almost everything under it isn’t' },
  { k: 'tt', name: 'tenstorrent blackhole', foot: `${f.card.cores} ai cores · ${f.card.memory_gb} gb · $${f.card.price_usd} · 5090-class matmul` },
];
const rows: ({ layer: string } & Record<Col, Side>)[] = [
  { layer: 'framework', amd: { t: 'pytorch', open: true }, nv: { t: 'pytorch', open: true }, tt: { t: 'pytorch, jax', open: true } },
  { layer: 'compiler', amd: { t: 'llvm', open: true }, nv: { t: 'nvcc, ptxas', open: false }, tt: { t: 'tt-mlir, sfpi', open: true } },
  { layer: 'kernel libraries', amd: { t: 'rocblas, miopen', open: true }, nv: { t: 'cublas, cudnn', open: false }, tt: { t: 'tt-metalium', open: true } },
  { layer: 'runtime', amd: { t: 'rocm, hip', open: true }, nv: { t: 'cuda, libcuda', open: false }, tt: { t: 'tt-metalium, umd', open: true } },
  { layer: 'kernel driver', amd: { t: 'amdgpu', open: true }, nv: { t: 'open modules', open: true }, tt: { t: 'tt-kmd', open: true } },
  { layer: 'firmware', amd: { t: 'signed blobs', open: false }, nv: { t: 'signed blobs', open: false }, tt: { t: 'tt-system-fw', open: 'mostly' } },
  { layer: 'instruction set', amd: { t: 'documented', open: true }, nv: { t: 'undocumented', open: false }, tt: { t: 'documented', open: true } },
  { layer: 'circuit design', amd: { t: 'secret', open: false }, nv: { t: 'secret', open: false }, tt: { t: 'secret', open: false } },
];
const score = (k: Col) => rows.filter((r) => r[k].open).length;
const tag = (s: Side) => (s.open === true ? 'open' : s.open ? 'mostly' : 'closed');
---
<header>
  <div class="section">the problem</div>
  <h2>most ai runs on closed chips. this one is open</h2>
</header>
<div class="cmp" data-steps="2">
  <div class="head"></div>
  {cols.map((c) => <div class={`head ${c.k}`}>{c.name} <span class={score(c.k) >= 6 ? 'hi' : 'lo'}>{score(c.k)} / {rows.length} open</span></div>)}
  {rows.map((r) => (
    <>
      <div class="layer">{r.layer}</div>
      {cols.map((c) => <div class={`cell ${c.k} ${r[c.k].open ? 'open' : 'closed'}`}><code>{r[c.k].t}</code><b>{tag(r[c.k])}</b></div>)}
    </>
  ))}
  <div></div>
  {cols.map((c) => <div class={`foot ${c.k}`}>{c.foot}</div>)}
</div>
<style>
  .cmp { display: grid; grid-template-columns: 190px repeat(3, 430px); gap: 8px 14px; justify-content: center; align-items: stretch; }
  .head { font-size: 26px; font-weight: 750; padding: 0 4px 4px; white-space: nowrap; }
  .head span { font-size: 18px; font-weight: 600; margin-left: .4em; }
  .head .lo { color: var(--bad); }
  .head .hi { color: var(--good); }
  .layer { font-size: 20px; color: var(--muted); text-align: right; align-self: center; white-space: nowrap; }
  .cell { display: flex; justify-content: space-between; align-items: center; gap: 10px; border-radius: 10px; padding: 7px 14px; border: 2px solid; }
  .cell code { font-family: var(--mono); font-size: 19px; background: none; padding: 0; white-space: nowrap; }
  .cell b { font-size: 15px; font-weight: 750; text-transform: uppercase; letter-spacing: .06em; white-space: nowrap; }
  .cell.open { background: var(--tint-green); border-color: var(--good); }
  .cell.open b { color: var(--good); }
  .cell.closed { background: color-mix(in srgb, var(--bad) 12%, transparent); border-color: color-mix(in srgb, var(--bad) 55%, transparent); }
  .cell.closed b { color: var(--bad); }
  .foot { font-size: 19px; line-height: 1.3; color: var(--muted); padding: 6px 4px 0; }
  .foot.tt { color: var(--fg); font-weight: 650; }
  /* nvidia first, then amd (step 1), then tenstorrent (step 2) */
  .amd, .tt { transition: opacity .3s, transform .3s; }
  :global(.slide[data-step="0"]) .amd { opacity: 0; transform: translateX(-12px); }
  :global(.slide[data-step="0"]) .tt, :global(.slide[data-step="1"]) .tt { opacity: 0; transform: translateX(12px); }
</style>
