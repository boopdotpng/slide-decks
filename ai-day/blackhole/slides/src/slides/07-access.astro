---
// why the mac port matters: who can run this chip now, what it costs, what you get, and the response when it went out.
// the post's numbers live in facts.json (post): refresh them before the event
import f from '../facts.json';
const p = f.post;
---
<header>
  <div class="section">why it matters</div>
  <h2>bringing ai compute to everyone</h2>
</header>
<div class="access">
  <div class="left">
    <div class="before">
      <span class="tag">before</span>
      <span>a linux tower with a free pcie slot, or a cloud rental</span>
    </div>
    <div class="tag now-tag">now</div>
    <div class="tiers">
      <div class="tier">
        <div class="price">{f.card.memory_gb} gb</div>
        <b>what you get</b>
        <span>{f.card.cores} ai cores, {f.card.memory_gb} gb of memory, open from the driver up</span>
      </div>
      <div class="tier hot">
        <div class="price">${(f.card.price_usd + f.mac.dock_usd).toLocaleString('en-US')}</div>
        <b>+ the laptop you have</b>
        <span>${f.card.price_usd} card + ~${f.mac.dock_usd} egpu dock, over thunderbolt</span>
      </div>
    </div>
  </div>
  <div class="post step">
    <div class="who">
      <div class="avatar">b</div>
      <div><b>{p.name}</b> <span>{p.handle}</span></div>
    </div>
    <p class="text">{p.text}</p>
    <img src="/img/setup.jpg" alt="" />
    <div class="nums">
      <div class="big"><b>{p.views}</b><span>views</span></div>
      <div class="big"><b>{p.likes}</b><span>likes</span></div>
    </div>
  </div>
</div>
<p class="callout step">more people can run tenstorrent hardware, for less, and they want to</p>
<style>
  .access { display: flex; align-items: center; justify-content: center; gap: 56px; }
  .left { width: 820px; }
  .tag { font-size: 20px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .before { display: flex; gap: 18px; align-items: baseline; background: var(--panel); border: 2px solid var(--border);
    border-radius: 12px; padding: 14px 22px; font-size: 24px; color: var(--muted); opacity: .8; }
  .now-tag { color: var(--good); margin: 26px 0 10px; }
  .tiers { display: flex; gap: 20px; }
  .tier { flex: 1; background: var(--panel); border: 2px solid var(--border); border-radius: 14px; padding: 18px 24px; }
  .tier.hot { border: 3px solid var(--good); background: var(--tint-green); }
  .price { font-size: 76px; font-weight: 800; line-height: 1; margin-bottom: 10px; }
  .tier.hot .price { color: var(--good); }
  .tier b { display: block; font-size: 30px; }
  .tier span { display: block; font-size: 22px; line-height: 1.3; color: var(--muted); margin-top: 4px; }

  .post { width: 560px; background: var(--panel); border: 2px solid var(--border); border-radius: 18px; padding: 20px 24px; }
  .who { display: flex; align-items: center; gap: 12px; font-size: 22px; }
  .who span { color: var(--muted); }
  .avatar { width: 44px; height: 44px; border-radius: 50%; background: var(--accent); color: var(--on-color);
    display: grid; place-items: center; font-weight: 800; font-size: 24px; }
  .text { font-size: 23px; line-height: 1.35; margin: 12px 0; }
  .post img { width: 100%; height: 170px; object-fit: cover; border-radius: 12px; display: block; }
  .nums { display: flex; gap: 26px; margin-top: 14px; align-items: flex-end; }
  .nums div { display: flex; flex-direction: column; gap: 4px; line-height: 1; }
  .nums b { font-size: 26px; }
  .nums span { font-size: 17px; color: var(--muted); }
  .nums .big b { font-size: 44px; color: var(--good); line-height: 1; }
  .callout { text-align: center; margin-top: 36px; font-size: 36px; font-weight: 700; color: var(--good); }
</style>
