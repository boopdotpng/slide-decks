---
// backup: what the card runs for every token of the demo (kernels/llama3-1b-p100a/manifest.json)
import f from '../facts.json';
---
<header data-title="one token = 83 kernel launches">
  <div class="section">backup · one token at a time</div>
  <h2>each token the demo prints takes {f.llama.launches_per_token} hand-written kernel launches</h2>
  <p class="sub">a token is a piece of a word. {f.llama.programs} kernel programs, written in risc-v and tensix assembly, each spread across up to {f.llama.max_cores} cores</p>
</header>
<div class="onetok">
  <div class="flow">
    <div class="k"><b>embedding</b><span>look up the last token</span></div>
    <div class="arr">→</div>
    <div class="layer">
      <div class="lk">
        <div class="k att"><b>qkv</b></div><div class="k att"><b>attention</b></div><div class="k att"><b>o</b></div>
        <div class="k mlp"><b>gate</b></div><div class="k mlp"><b>down</b></div>
      </div>
      <div class="lcap"><span class="a">look back at earlier tokens</span><span class="m">then think about them</span></div>
      <div class="times">× {f.llama.layers} layers</div>
    </div>
    <div class="arr">→</div>
    <div class="k"><b>lm</b><span>score every possible next token</span></div>
    <div class="arr">→</div>
    <div class="k pick"><b>argmax</b><span>pick the best one</span></div>
  </div>
  <p class="count">1 + {f.llama.layers} × 5 + 2 = <b>{f.llama.launches_per_token} launches</b> per token</p>
  <div class="facts">
    <div class="step"><b>recorded once</b><span>the {f.llama.launches_per_token} launches are saved as a graph when the model loads</span></div>
    <div class="step"><b>one command per token</b><span>the mac sends a single “replay” and the card runs the whole graph</span></div>
    <div class="step"><b>straight back to the mac</b><span>argmax writes the chosen token directly into the mac’s memory</span></div>
  </div>
</div>
<style>
  .onetok { display: flex; flex-direction: column; align-items: center; }
  .flow { display: flex; align-items: flex-start; gap: 12px; }
  .arr { font-size: 40px; color: var(--faint); padding-top: 12px; }
  .k { background: var(--panel); border: 2px solid var(--line); border-radius: 10px; padding: 8px 14px; text-align: center; width: 200px; }
  .k b { display: block; font-size: 26px; font-family: var(--mono); }
  .k span { font-size: 18px; color: var(--muted); line-height: 1.2; display: block; }
  .k.pick { border-color: var(--good); }
  .layer { border: 2px dashed var(--line-2); border-radius: 14px; padding: 12px; }
  .lk { display: flex; gap: 8px; }
  .lk .k { width: auto; padding: 8px 12px; }
  .k.att { border-color: var(--accent); }
  .k.mlp { border-color: var(--purple); }
  .lcap { display: flex; justify-content: space-between; font-size: 18px; margin-top: 6px; gap: 12px; }
  .lcap .a { color: var(--accent); } .lcap .m { color: var(--purple); }
  .times { text-align: center; font-size: 26px; font-weight: 700; margin-top: 4px; }
  .count { font-size: 28px; margin: 22px 0 18px; color: var(--muted); }
  .count b { color: var(--fg); }
  .facts { display: flex; gap: 18px; }
  .facts div { width: 440px; background: var(--panel); border-left: 6px solid var(--accent); border-radius: 10px; padding: 10px 18px; }
  .facts b { display: block; font-size: 26px; }
  .facts span { display: block; font-size: 20px; line-height: 1.3; color: var(--muted); }
</style>
