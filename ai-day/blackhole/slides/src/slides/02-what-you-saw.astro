---
import f from '../facts.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // the site lives under a base path, so public/ files need it
---
<header data-title="that's llama on a $999 ai card, on a macbook">
  <div class="section">the demo</div>
  <h2>llama on a <em>${f.card.price_usd}</em> ai card, plugged into a macbook</h2>
</header>
<div class="saw">
  <div class="left">
    <div class="photo">
      <img src={`${base}/img/setup.jpg`} alt="a tenstorrent p100a card in a thunderbolt enclosure, cabled to a macbook running the demo" />
      <div class="tags step">
        <span class="tag" style="left: 4%; top: 46%">tenstorrent blackhole p100a</span>
        <span class="tag" style="left: 18%; top: 88%">thunderbolt enclosure</span>
        <span class="tag" style="left: 56%; top: 6%">macbook, plain python</span>
      </div>
    </div>
    <div class="stats">
      <div><b>{f.demo.model}</b><span>chat model</span></div>
      <div><b>{Math.round(f.demo.tok_s)} tokens / s</b><span>{f.demo.words_per_s} words a second</span></div>
    </div>
  </div>
  <div class="right">
    <img class="termshot" src={`${base}/img/terminal.png`} alt="terminal: Llama 3.2 1B on p100a, startup 0.86 s, decode 145.9 tok/s" />
    <p class="callout">until now, this card only ran in linux desktops and full pcs</p>
  </div>
</div>
<style>
  .saw { display: flex; gap: 44px; align-items: flex-start; }
  .left { width: 860px; flex: none; }
  .photo { position: relative; }
  .photo img { width: 100%; display: block; border-radius: 14px; }
  .tags { position: absolute; inset: 0; }
  .tag { position: absolute; font-size: 22px; font-weight: 650; padding: 4px 14px; border-radius: 999px;
    background: var(--hot); color: var(--on-color); white-space: nowrap; }
  .stats { display: flex; gap: 14px; margin-top: 18px; }
  .stats div { flex: 1; background: var(--panel); border: 2px solid var(--border); border-radius: 12px; padding: 10px 16px; }
  .stats b { display: block; font-size: 30px; }
  .stats span { display: block; font-size: 20px; line-height: 1.3; color: var(--muted); }
  .right { flex: 1; min-width: 0; }
  .termshot { width: 100%; display: block; border-radius: 12px; border: 2px solid var(--border); }
  h2 em { font-style: normal; color: var(--good); }
  .callout { margin-top: 22px; font-size: 32px; font-weight: 650; color: var(--good); line-height: 1.25; }
</style>
