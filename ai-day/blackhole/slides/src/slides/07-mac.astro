---
import Stack, { type Layer } from '../components/Stack.tsx';
import { Bars } from 'slides/viz';
import f from '../facts.json';
// decode is memory-bound, so compare how much of each card's memory bandwidth it uses, not raw tok/s
// (the p100a has 7 dram channels to the p150a's 8). bytes read per token come from the desktop row:
// 78% of 512 GB/s over 6.21 ms ≈ 2.48 GB (≈ llama 3.2 1b in bf16); the mac reads the same bytes in 6.85 ms.
const gbPerToken = (f.desktop.dram_pct / 100) * f.desktop.bandwidth_gb_s * (f.desktop.ms_per_token / 1000);
const macPct = Math.round((gbPerToken / (f.demo.ms_per_token / 1000) / f.card.bandwidth_gb_s) * 100);
const official: Layer[] = [
  { t: 'your model', tone: 'dim' },
  { t: 'tt-forge · tt-nn', tone: 'dim' },
  { t: 'tt-metalium', tone: 'dim' },
  { t: 'kernel library', tone: 'dim' },
  { t: 'linux driver', tone: 'dim' },
  { t: 'the card', tone: 'hw' },
];
const ours: Layer[] = [
  { t: 'llama3.py', sub: 'unchanged', tone: 'code' },
  { t: 'blackhole-py', sub: 'small runtime, mostly python', tone: 'ours' },
  { t: `~${f.mac.python_lines} lines of python`, sub: 'sets up and talks to the card', tone: 'ours', litAt: 0 },
  { t: 'a small macos driver', sub: 'connects the card to python', tone: 'ours', litAt: 0 },
  { t: 'the card', sub: 'over thunderbolt', tone: 'hw' },
];
---
<header>
  <div class="section">how it runs on a mac</div>
  <h2>we rebuilt the bottom of the stack in python</h2>
</header>
<div class="mac">
  <div class="stacks">
    <Stack client:load title="official" layers={official} width={300} compact />
    <div><Stack client:load title="blackhole-py on a mac" layers={ours} width={460} compact /></div>
  </div>
  <div class="side">
    <h3>memory speed used</h3>
    <div class="bigbars"><Bars values={[macPct, f.desktop.dram_pct]} labels={['mac + egpu dock', 'linux desktop']} max={100} width={200}
      fmtV={(v) => `${v}%`} hl={0} /></div>
    <p class="cap">same efficiency. the p100a just has 1/8 less memory bandwidth than the desktop’s p150a ({Math.round(f.desktop.tok_s)} vs {Math.round(f.demo.tok_s)} tok/s)</p>
    <p class="callout">the egpu dock costs ~no speed, and the model code didn’t change</p>
  </div>
</div>
<style>
  .mac { display: flex; gap: 44px; align-items: center; justify-content: center; }
  .stacks { display: flex; gap: 36px; align-items: flex-end; }
  .side { width: 500px; font-size: 26px; }
  .side h3 { font-size: 26px; color: var(--muted); font-weight: 500; }
  .bigbars { font-size: 38px; }
  .bigbars :global(.bars) { row-gap: 14px; }
  .cap { font-size: 22px; color: var(--muted); margin-top: 10px; }
  .callout { margin-top: 30px; font-size: 30px; font-weight: 650; color: var(--good); line-height: 1.25; }
</style>
