---
// backup: inside one of the 120 cores. the five tiny risc-v cpus each run one stage, like an assembly line
import { Arrow, Box } from 'slides/viz';
import f from '../facts.json';
const W = 185, G = 30, Y = 40, H = 130;
const x = (i: number) => 10 + i * (W + G);
const stages = [
  { t: 'memory', s: `${f.card.memory_gb} gb gddr6`, mem: true },
  { t: 'read', s: 'risc-v 1' },
  { t: 'unpack', s: 'risc-v 2' },
  { t: 'math', s: 'risc-v 3' },
  { t: 'pack', s: 'risc-v 4' },
  { t: 'write', s: 'risc-v 5' },
  { t: 'memory', s: 'results out', mem: true },
];
const mid = x(3) + W / 2;
---
<header>
  <div class="section">backup · inside one core</div>
  <h2>each core is a tiny assembly line</h2>
  <p class="sub">{f.card.riscv_per_core} small risc-v cpus, one per stage, feeding two math engines. all five work at once on different blocks of data</p>
</header>
<div class="core fill">
  <svg viewBox="0 0 1500 560" width="100%">
    {stages.map((st, i) => (
      <Box x={x(i)} y={Y} w={W} h={H} title={st.t} sub={st.s}
        fill={st.mem ? 'var(--fill-amber)' : i === 3 ? 'var(--tint-blue)' : 'var(--panel)'}
        stroke={st.mem ? 'var(--hot)' : i === 3 ? 'var(--accent)' : 'var(--line)'} />
    ))}
    {stages.slice(1).map((_, i) => <Arrow from={[x(i) + W, Y + H / 2]} to={[x(i + 1) - 2, Y + H / 2]} width={3} />)}
    <Box x={mid - 330} y={240} w={300} h={120} title="matrix engine" sub="fast: grids of numbers" fill="var(--fill-blue)" stroke="var(--accent)" />
    <Box x={mid + 30} y={240} w={300} h={120} title="vector engine" sub={`~${f.card.vector_vs_matrix}× slower: exp, sqrt`} fill="var(--fill-violet)" stroke="var(--purple)" />
    <Arrow from={[mid - 20, Y + H]} to={[mid - 180, 236]} width={3} />
    <Arrow from={[mid + 20, Y + H]} to={[mid + 180, 236]} width={3} />
    <Box x={x(1)} y={420} w={x(5) + W - x(1)} h={110} title={`${f.card.core_sram_mb} mb of core memory (sram)`}
      sub="every stage hands data through here. there is no cache anywhere on the card" fill="var(--fill-slate)" stroke="var(--line-2)" />
  </svg>
</div>
<style>
  .core { display: flex; align-items: center; }
</style>
