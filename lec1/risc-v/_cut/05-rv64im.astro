---
import Code from '../components/Code.tsx';
---
<h2 class="named"><span class="wide" data-label="risc-v, 64-bit" style="--row: 3">rv64</span><span data-label="integer base" style="--row: 2">i</span><span data-label="multiply / divide" style="--row: 1">m</span>: everything you get</h2>
<table class="isa">
  <tr><td>math</td><td><Code lang="asm" code={"add  t0, t1, t2      # t0 = t1 + t2\n                     # also sub mul div, and or xor, shifts"} /></td></tr>
  <tr><td>constants</td><td><Code lang="asm" code={"addi t0, zero, 5     # the 5 is inside the instruction\nlui  t0, 244         # too big? t0 = 244 << 12\naddi t0, t0, 576     # + 576 = 1000000"} /></td></tr>
  <tr><td>loads / stores</td><td><Code lang="asm" code="ld   t0, 8(sp)       # t0 = memory[sp + 8]" /></td></tr>
  <tr><td>branches / jumps</td><td><Code lang="asm" code={"beq  t0, t1, done    # if t0 == t1, pc = done\njal  ra, func        # call: ra = pc + 4, pc = func"} /></td></tr>
  <tr><td>syscalls</td><td><Code lang="asm" code="ecall                # ask the kernel" /></td></tr>
</table>
<p class="muted step">that's the core. everything else is built out of these.</p>
<style>
  /* leader lines from each part of the name down to a small label */
  .named { margin-bottom: 1.2em; }
  .named span { position: relative; }
  .named span::after {
    content: attr(data-label);
    position: absolute; left: 50%; top: 95%;
    height: calc(var(--row) * 1.3em);
    display: flex; align-items: flex-end;
    padding-left: .4em;
    border-left: 1px solid var(--muted);
    font-size: .3em; font-weight: normal; line-height: 1;
    color: var(--muted); white-space: nowrap;
  }
  /* bracket under the whole of a multi-letter part, leader drops from its middle */
  .named .wide::before {
    content: '';
    position: absolute; left: .05em; right: .05em; top: 95%;
    height: .12em;
    border: 1px solid var(--muted); border-top: none;
  }
  .named .wide::after { top: calc(95% + .4em); height: calc(var(--row) * 1.3em - .4em); } /* .4em of the label font = the bracket's .12em */
  .isa { font-size: .72em; }
  .isa td:first-child { color: var(--muted); padding-right: 1.5em; white-space: nowrap; }
  .isa pre { margin: .2em 0; font-size: .8em; }
</style>
