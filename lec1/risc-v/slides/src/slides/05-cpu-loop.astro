---
import { Walkthrough } from '../components/viz';

// straight-line code: no jumps yet, so pc just goes up by 4
const code = `
0x00  addi t1, zero, 3
0x04  addi t2, zero, 4
0x08  add  t3, t1, t2
0x0c  ebreak`;
---
<header>
  <h2>what a cpu does, forever</h2>
</header>
<ol class="loop-rule small">
  <li>read the instruction at the address in <b>pc</b> (the program counter)</li>
  <li>do it</li>
  <li>pc += 4 <span class="muted">(every instruction is 4 bytes)</span>, repeat</li>
</ol>
<div data-steps="4" class="cpu-walk">
  <Walkthrough client:load lang="asm" code={code}
    vars={[{ name: 'pc' }, { name: 't1', reg: true }, { name: 't2', reg: true }, { name: 't3', reg: true }]}
    initial={{ t1: 0, t2: 0, t3: 0 }}
    steps={[
      { hl: [], set: { pc: '0x00' }, text: 'four instructions in memory. pc points at the first one' },
      { hl: [0], set: { pc: '0x04', t1: 3 }, text: 't1 = 0 + 3. then pc moves to the next instruction' },
      { hl: [1], set: { pc: '0x08', t2: 4 }, text: 't2 = 0 + 4' },
      { hl: [2], set: { pc: '0x0c', t3: 7 }, text: 't3 = t1 + t2 = 7' },
      { hl: [3], set: { pc: '0x10' }, text: 'ebreak: stop and show the registers (our emulator prints all 32). that\'s the whole machine' },
    ]} />
</div>
<style>
  .loop-rule { margin: 0 0 .6em; }
  .loop-rule li { margin: .1em 0; }
  .cpu-walk { font-size: 1.2em; }
</style>
