---
import GenLoop from '../components/GenLoop.tsx';
import { StepCode } from '../components/viz';
const SRC = `
ids = prompt_ids
for _ in range(max_new_tokens):
  next_id = model(Tensor([ids])).item()   # the whole sequence, every time
  ids.append(next_id)`;
---
<h2>generation is a loop</h2>
<div data-steps="3"><GenLoop client:load /></div>
<StepCode client:load code={SRC} hl={{ 0: [2], 1: [2, 3], 2: [2, 3], 3: [2, 3] }} />
