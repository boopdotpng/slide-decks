---
import Math from '../components/Math.astro';
import { Where } from '../components/Where.tsx';
import { Tok } from '../components/viz';
// one head, following one token (the last, ' to'); j runs over every token it can look at
const LINES = [
  ['q = x\\,W_Q \\qquad k_j = x_j\\,W_K \\qquad v_j = x_j\\,W_V',
    'each token: 768 numbers → a 64-number q, k, v. every head has its own three W, each 768 × 64'],
  ['s_j = \\dfrac{q \\cdot k_j}{\\sqrt{64}} \\quad\\Longrightarrow\\quad s = \\dfrac{q\\,K^\\top}{\\sqrt{64}}',
    'one score per token j: how well j matches what this token wants. stack the kⱼ as rows of K (14 × 64): q Kᵀ is all 14 dot products at once (a matmul dots rows with columns, hence the flip)'],
  ['p = \\operatorname{softmax}(s)', 'scores → weights that sum to 1'],
  ['\\text{out} = \\sum_j p_j\\, v_j \\quad\\Longrightarrow\\quad \\text{out} = p\\,V',
    'blend the values by those weights: 64 numbers out. stack the vⱼ as rows of V (14 × 64): p (1 × 14) @ V gives all 64 at once. no flip needed, V\'s rows already line up with p'],
];
---
<Where at="attn" />
<h2>attention, one head</h2>
<p class="lead muted">one head, one token x (the last one, <Tok t=" to" />), looking at every token x<sub>j</sub> up to and including itself</p>
<div class="eqs">
  {LINES.map(([tex, what]) => (
    <div class="eq step"><Math tex={tex} block /><span class="what muted">{what}</span></div>
  ))}
</div>
<p class="step foot muted">next: these four lines with real numbers, block 10 head 7</p>
<style>
  .lead { font-size: .65em; margin: 0 0 .8em; }
  .eqs { display: flex; flex-direction: column; gap: .2em; }
  .eq { display: grid; grid-template-columns: 23em 1fr; gap: 2em; align-items: center; }
  .eq :global(.katex-display) { margin: .25em 0; text-align: left; }
  .eq :global(.katex-display > .katex) { text-align: left; font-size: 1.05em; }
  .what { font-size: .6em; }
  .foot { font-size: .6em; margin-top: 1em; }
</style>
