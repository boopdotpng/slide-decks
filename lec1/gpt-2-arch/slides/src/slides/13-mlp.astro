---
import MLPViz from '../components/MLPViz.tsx';
import { Where } from '../components/Where.tsx';
import { StepCode } from '../components/viz';
const SRC = `
up = self.up_proj(x)            # (B, S, mlp_size): 768 -> 3072
hidden = up.gelu()              # gelu_new == tanh approximation
return self.down_proj(hidden)   # (B, S, emb_dim): 3072 -> 768
# back in Block:
x = x + self.mlp(self.post_attention_layernorm(x))`;
---
<Where at="mlp" />
<div class="section">one pass</div>
<h2>mlp</h2>
<div data-steps="3"><MLPViz client:load /></div>
<StepCode client:load code={SRC} hl={{ 1: [0], 2: [1], 3: [2, 4] }} />
