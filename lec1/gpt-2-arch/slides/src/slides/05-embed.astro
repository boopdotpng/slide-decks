---
import EmbedLookup from '../components/EmbedLookup.tsx';
import { Where } from '../components/Where.tsx';
import { StepCode } from '../components/viz';
const SRC = `
self.embed_tokens = nn.Embedding(vocab_size, emb_dim)   # (50257, 768)
tok_emb = self.embed_tokens(tokens)                     # (B, S, emb_dim)`;
---
<Where at="embed" />
<h2>token embedding: a lookup</h2>
<div data-steps="3"><EmbedLookup client:load /></div>
<StepCode client:load code={SRC} hl={{ 0: [0], 1: [0], 2: [1], 3: [1] }} />
