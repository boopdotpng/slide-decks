---
import Unembed from '../components/Unembed.tsx';
import { Where } from '../components/Where.tsx';
import { StepCode } from '../components/viz';
const SRC = `
x = self.norm(x)                                # (B, S, emb_dim)
logits = x @ self.embed_tokens.weight.T         # (B, S, vocab_size): weight tying
next_id = logits[:, -1, :].flatten().argmax()   # greedy: only the last position`;
---
<Where at="unembed" />
<div class="section">one pass</div>
<h2>next token</h2>
<div data-steps="2"><Unembed client:load /></div>
<StepCode client:load code={SRC} hl={{ 0: [0], 1: [1], 2: [2] }} />
