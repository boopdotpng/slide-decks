---
import Tokenize from '../components/Tokenize.tsx';
import { Where } from '../components/Where.tsx';
import { StepCode } from '../components/viz';
const SRC = `
prompt_ids = tokenizer.encode(prompt).ids
tokens = Tensor([prompt_ids])                     # (1, S)`;
---
<Where at="tokens" />
<h2>text → token ids</h2>
<div data-steps="3"><Tokenize client:load /></div>
<StepCode client:load code={SRC} hl={{ 1: [0], 2: [1], 3: [0] }} />
