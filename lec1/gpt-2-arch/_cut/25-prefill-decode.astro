---
import GenLoop from '../components/GenLoop.tsx';
import { StepCode } from '../components/viz';
const SRC = `
# prefill: the whole prompt in one forward pass, fills the kv cache
next_id = model(Tensor([prompt_ids]), start_pos=0).item()
# decode: one token at a time, each attends over the cache
next_id = model(Tensor([[next_id]]), start_pos=len(prompt_ids) + i).item()`;
---
<div class="section">kv cache</div>
<h2>the loop, again: prefill, then decode</h2>
<div data-steps="3"><GenLoop split client:load /></div>
<StepCode client:load code={SRC} hl={{ 0: [0, 1], 1: [2, 3], 2: [2, 3], 3: [2, 3] }} />
