---
import OutProj from '../components/OutProj.tsx';
import { Where } from '../components/Where.tsx';
import { StepCode } from '../components/viz';
const SRC = `
out = out.transpose(1, 2).reshape(B, S, emb_dim)   # concat heads back together
return self.o_proj(out)                            # (B, S, emb_dim)
# back in Block:
x = x + self.self_attn(self.input_layernorm(x), start_pos)`;
---
<Where at="attn" />
<div class="section">one pass</div>
<h2>heads → residual stream</h2>
<div data-steps="3"><OutProj client:load /></div>
<StepCode client:load code={SRC} hl={{ 1: [0], 2: [1], 3: [3] }} />
