---
import KVCache from '../components/KVCache.tsx';
import { Where } from '../components/Where.tsx';
import { StepCode } from '../components/viz';
const SRC = `
kv = Tensor.stack(k, v)                   # (2, B, n_heads, S, head_dim)
# ...stored into self.kv_cache[:, :B, :, start_pos:start_pos+S]
k = kv_cache[0, :B, :, :start_pos+S, :]   # (B, n_heads, T, head_dim)
v = kv_cache[1, :B, :, :start_pos+S, :]`;
---
<Where at="attn" />
<div class="section">kv cache</div>
<h2>kv cache: compute k, v once</h2>
<div data-steps="1"><KVCache client:load /></div>
<StepCode client:load code={SRC} hl={{ 0: [2, 3], 1: [0, 1] }} />
