---
import EmbSim from '../components/EmbSim.tsx';
import { Where } from '../components/Where.tsx';
---
<Where at="embed" />
<h2>similar tokens, similar rows</h2>
<div data-steps="2"><EmbSim client:load /></div>
<p class="caption" style="font-size: .5em; margin-top: 1.2em">
  each cell compares two rows of <code>embed_tokens</code> (one 768-number row per token), from gpt-2's trained weights<br />
  <code style="white-space: nowrap">cos(a, b) = a·b / (‖a‖ ‖b‖)</code> &nbsp;1 = same direction, 0 = unrelated
</p>
