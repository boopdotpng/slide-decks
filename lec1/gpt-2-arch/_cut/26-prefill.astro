---
import PrefillQK from '../components/PrefillQK.tsx';
import { Where } from '../components/Where.tsx';
import { StepCode } from '../components/viz';
const SRC = `
# q, k, v: (B, n_heads, S, head_dim), all S prompt tokens at once
scores = q @ k.transpose(-2, -1)   # (B, n_heads, S, T): now a real matmul`;
---
<Where at="attn" />
<div class="section">prefill</div>
<h2>Q @ Kᵀ</h2>
<div data-steps="2"><PrefillQK client:load /></div>
<StepCode client:load code={SRC} hl={{ 1: [1], 2: [1] }} />
